# ==========================================================================
# Government Scheme Assistant - backend environment variables
# Copy this file to `.env` in the project root and fill in your values.
# NEVER commit your real keys. `.env` is already in .gitignore.
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME="Government Scheme Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- LLM provider ----------------------------------------------------------
# auto | grok | groq | openai | offline
# `auto` picks the first provider that has a key: grok -> groq -> openai -> offline.
# `offline` never calls a network API (answers are generated from the knowledge
# base only, which still works fully - useful for a demo without a key).
LLM_PROVIDER=auto

# --- Grok (xAI) - the default LLM for this project -------------------------
# Get a key from https://console.x.ai/
GROK_API_KEY=your_key_here
GROK_MODEL=grok-4.6
GROK_BASE_URL=https://api.x.ai/v1

# --- Groq (optional free-tier alternative) ---------------------------------
# Get a key from https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (optional, shows how to swap providers) ------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM behaviour ---------------------------------------------------------
# Keep the temperature low so the model stays factual.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60

# --- Knowledge base --------------------------------------------------------
KNOWLEDGE_BASE_FILE=schemes.jsonl

# --- RAG / retrieval -------------------------------------------------------
# How many chunks the retriever returns.
RAG_TOP_K=6
# Safety cap on indexed chunks.
RAG_MAX_CHUNKS=60
# 1.0 = BM25 only, 0.0 = embeddings only, 0.7 = hybrid (default).
RAG_LEXICAL_WEIGHT=0.7
# Set to false to run fully offline with BM25 only (no model download).
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
